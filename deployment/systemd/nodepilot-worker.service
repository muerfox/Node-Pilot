[Unit]
Description=NodePilot Controller -- Celery worker (VM/disk/network/snapshot/backup jobs)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=nodepilot
Group=nodepilot
WorkingDirectory=/opt/nodepilot/backend
EnvironmentFile=/opt/nodepilot/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/nodepilot/backend/.venv/bin/celery -A config worker \
    --loglevel=info --concurrency=4
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nodepilot

[Install]
WantedBy=multi-user.target
