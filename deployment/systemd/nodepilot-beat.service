[Unit]
Description=NodePilot Controller -- Celery Beat (scheduled backups, offline-node sweeps, retention)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=nodepilot
Group=nodepilot
WorkingDirectory=/opt/nodepilot/backend
EnvironmentFile=/opt/nodepilot/backend/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/nodepilot/backend/.venv/bin/celery -A config beat \
    --loglevel=info --scheduler django_celery_beat.schedulers:DatabaseScheduler
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nodepilot

[Install]
WantedBy=multi-user.target
