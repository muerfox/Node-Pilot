# Used by docker-compose.yml for local development only.
# Production configuration lives in backend/.env (see backend/.env.example)
# and agent/etc/nodepilot/agent.yaml on each hypervisor -- see
# docs/installation.md.

# Once you've registered a dev node via `nodepilot agent register` (or the
# API directly) and want to bring up the nodepilot-agent-dev profile:
DEV_NODE_ID=
DEV_AGENT_TOKEN=
