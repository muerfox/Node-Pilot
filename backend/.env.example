# Django
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production
TIME_ZONE=UTC

# PostgreSQL
POSTGRES_DB=nodepilot
POSTGRES_USER=nodepilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT / tokens
JWT_SIGNING_KEY=change-me-to-a-different-long-random-value
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://nodepilot.example.com
CSRF_TRUSTED_ORIGINS=https://nodepilot.example.com
SECURE_COOKIES=true

# NodePilot domain settings
HEARTBEAT_INTERVAL_SECONDS=10
OFFLINE_THRESHOLD_SECONDS=30
AGENT_RPC_TIMEOUT_SECONDS=30
MIN_SUPPORTED_AGENT_VERSION=1.0.0
NODEPILOT_CONTROLLER_VERSION=0.1.0
METRICS_RETENTION_SECONDS=3600
WEBHOOK_MAX_RETRIES=6
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# Media / uploads
MEDIA_ROOT=/var/lib/nodepilot/media
IMAGE_UPLOAD_CHUNK_DIR=/var/lib/nodepilot/media/uploads/chunks
